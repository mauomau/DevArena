# =============================================================================
# DevArena — variables d'environnement
# Copier ce fichier vers `.env.local` puis remplir les valeurs.
# Ne jamais commiter `.env.local`.
# =============================================================================

# --- Supabase -----------------------------------------------------------------
# Tableau de bord Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=votre-cle-publique-anon

# ⚠️ Clé secrète : uniquement côté serveur (API Routes). Ne jamais exposer.
SUPABASE_SERVICE_ROLE_KEY=votre-cle-secrete-service-role

# --- Club Dev -----------------------------------------------------------------
# Lien d'invitation du groupe WhatsApp affiché via les QR codes.
# Laisser vide pour afficher un emplacement « à configurer ».
NEXT_PUBLIC_WHATSAPP_GROUP_URL=https://chat.whatsapp.com/votre-lien
